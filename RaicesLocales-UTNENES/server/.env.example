# Copiá este archivo como ".env" (en esta misma carpeta) y completá tu clave.
# NUNCA subas el archivo .env a GitHub.

# Access Token de la CUENTA VENDEDORA DE PRUEBA
MP_ACCESS_TOKEN=APP_USR-XXXX

# Puerto local del servidor
PORT=3000

# Opcional: URL pública del túnel. Si la dejás vacía, se detecta sola.
# BASE_URL=https://tu-tunel.trycloudflare.com

# PostgreSQL local. Cambiá PGUSER y PGPASSWORD según tu instalación.
PGHOST=localhost
PGPORT=5432
PGDATABASE=artesanos
PGUSER=postgres
PGPASSWORD=
